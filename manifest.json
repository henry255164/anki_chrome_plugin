{
  "manifest_version": 3,
  "name": "Anki Web Clipper",
  "version": "1.0",
  "description": "Clip web content to Anki cards.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/"
  ],
  "action": {
    "default_title": "Toggle Anki Clipper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "floating-ui.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "floating-ui.html",
        "main.js",
        "modules/toolbar.js",
        "modules/ui.js",
        "modules/image.js",
        "vendor/dompurify.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}